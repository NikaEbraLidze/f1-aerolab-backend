generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Preset {
  id              String   @id @default(cuid())
  name            String
  speed           Float
  wingAngle       Float
  weight          Float
  dragCoefficient Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
